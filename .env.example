# ==========================================
# LeafLine / TreeTrack AI Environment Config (Example)
# ==========================================

# Gemini API Key: paste your Google Gemini API key below
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model choice (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Backend Configuration
PORT=8000
ENVIRONMENT=development
